float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixMV;
float4x4 _MatrixMVDistances;
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;
int _SelectionMode;

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
uint _SplatCount;

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

// Reset counter buffer (RWStructuredBuffer<uint>) to zero
RWStructuredBuffer<uint> _SplatCounter;

[numthreads(1, 1, 1)]
void CSResetCounter(uint3 id : SV_DispatchThreadID)
{
    _SplatCounter[0] = 0;
}

RWStructuredBuffer<uint> _SplatTileCounter;
uint _TotalTiles;

[numthreads(GROUP_SIZE, 1, 1)]
void CSResetTileCounter(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _TotalTiles)
        return;
    
    _SplatTileCounter[idx] = 0;
}

[numthreads(1, 1, 1)]
void CSOffsetTileAdder(uint3 id : SV_DispatchThreadID)
{
    int gridSize = _TotalTiles;
    for (int i = 1; i < gridSize; i++)
    {
        _SplatTileCounter[i] += _SplatTileCounter[i-1];
    }
}

// Copy counter value into draw args buffer
StructuredBuffer<uint> _SplatCounterRO; // same buffer as _SplatCounter, just read-only
RWStructuredBuffer<uint> _DrawArgs;
uint _Quad;

[numthreads(1, 1, 1)]
void CSCopyCounterToDrawArgs(uint3 id : SV_DispatchThreadID)
{
    uint indexCount = (_Quad == 1) ? 6 : 36;

    _DrawArgs[0] = indexCount; // index count per instance
    _DrawArgs[1] = _SplatCounterRO[0]; // instance count from counter
    _DrawArgs[2] = 0;
    _DrawArgs[3] = 0;
    _DrawArgs[4] = 0;
}

[numthreads(GROUP_SIZE,1,1)]
void CSSetIndices (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    _SplatSortKeys[idx] = idx;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcDistances (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint origIdx = _SplatSortKeys[idx];
    
    float3 pos = LoadSplatPos(origIdx);
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;

    _SplatSortDistances[idx] = FloatToSortableUint(pos.z);
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;
float _RMin;
float _AlfaMin;
uint _UseCulling;
uint _SplatCutoutsCount;

#define SPLAT_CUTOUT_TYPE_ELLIPSOID 0
#define SPLAT_CUTOUT_TYPE_BOX 1

struct GaussianCutoutShaderData // match GaussianCutout.ShaderData in C#
{
    float4x4 mat;
    uint typeAndFlags;
};

StructuredBuffer<GaussianCutoutShaderData> _SplatCutouts;
RWByteAddressBuffer _SplatSelectedBits;
ByteAddressBuffer _SplatDeletedBits;
uint _SplatBitsValid;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    
    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);
    float2 diagVec = normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

bool IsSplatCut(float3 pos)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_ELLIPSOID)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return invert;
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return invert;
        }
        finalCut |= !invert;
    }
    return finalCut;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData) 0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos, 1)).xyz;
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    // cutouts
    if (IsSplatCut(splat.pos))
    {
        centerClipPos.w = 0;
    }

    view.pos = centerClipPos;
    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams);
        
        DecomposeCovariance(cov2d, view.axis1, view.axis2);

        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
        float3 objViewDir = mul((float3x3) _MatrixWorldToObject, worldViewDir);
        objViewDir = normalize(objViewDir);

        half4 col;
        col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
        col.a = min(splat.opacity * opacityScale, 65000);
        view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
        view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
    }
    
    _SplatViewData[idx] = view;
}

RWStructuredBuffer<uint> _VisibleSplatSortKeys;
RWStructuredBuffer<uint> _VisibleSplatSortDistances;

[numthreads(GROUP_SIZE, 1, 1)]
void CSCalcViewDataCulled(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData) 0;
    
    float3 camSpace = mul(_MatrixMV, float4( splat.pos, 1)).xyz;
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos, 1)).xyz;
    
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    // cutouts
    if (IsSplatCut(splat.pos))
    {
        centerClipPos.w = 0;
    }
    
    if (_UseCulling == 1)
    {
        // alfa threshold culling
        if (splat.opacity * opacityScale <= _AlfaMin)
        {
            centerClipPos.w = 0;
        }
    }
    
    view.pos = centerClipPos;
    bool culled = centerClipPos.w <= 0;
    if (!culled)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams);
        
        DecomposeCovariance(cov2d, view.axis1, view.axis2);
    
        float r_p = max( length(view.axis1), length(view.axis2) ) / abs( camSpace.z );

        if (r_p <= _RMin)
        {
            culled = true; // reuse behind Cam to avoid using a return;
        } 
        else 
        {
            
            float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
            float3 objViewDir = mul((float3x3) _MatrixWorldToObject, worldViewDir);
            objViewDir = normalize(objViewDir);

            half4 col;
            col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
            col.a = min(splat.opacity * opacityScale, 65000);
            view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
            view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
        }
    }
    
    if (!culled)
    {
        uint writeIdx;
        InterlockedAdd(_SplatCounter[0], 1, writeIdx);
        
        _VisibleSplatSortKeys[writeIdx] = idx;
        _VisibleSplatSortDistances[writeIdx] = FloatToSortableUint(abs(camSpace.z));

    }
    
    _SplatViewData[idx] = view;
}


float ndc2Pix(float v, int S)
{
    return ((v * 0.5 + 0.5) * S);
}

void DecomposeCovarianceScaled(float3 cov2d, float boundPower, out float2 axis1, out float2 axis2)
{
    // Extract elements
    float a = cov2d.x; // c_xx
    float b = cov2d.y; // c_xy
    float d = cov2d.z; // c_yy

    // Compute eigenvalues of [a b; b d]:
    // trace = a + d, diff = a - d
    float trace = a + d;
    float halfDiff = 0.5f * (a - d);
    // radius = sqrt( ( (a - d)/2 )^2 + b^2 )
    float radius = sqrt(halfDiff * halfDiff + b * b);

    // eigenvalues:
    float lambda1 = 0.5f * trace + radius;
    float lambda2 = 0.5f * trace - radius;
    // Clamp to non-negative (covariance should be positive semidef, but numeric may cause small negative)
    lambda2 = max(lambda2, 0.0f);
    // lambda1 should be >= lambda2; if numeric issues invert, swap (unlikely with above formula)

    // Compute eigenvector for lambda1:
    float2 dir1;
    // For symmetric [a b; b d], an eigenvector for lambda1 can be (lambda1 - d, b) or (b, lambda1 - a).
    // Choose (lambda1 - d, b) unless b~0, then pick axis aligned.
    if (abs(b) > 1e-6f)
    {
        dir1 = normalize(float2(lambda1 - d, b));
    }
    else
    {
        // If b is zero, matrix is diagonal. Pick direction along larger variance:
        dir1 = (a >= d) ? float2(1.0f, 0.0f) : float2(0.0f, 1.0f);
    }
    // Orthonormal perpendicular:
    float2 dir2 = float2(-dir1.y, dir1.x);

    // Scale axes by sqrt(eigenvalue * boundPower):
    // If boundPower <= 0, result will be zero-length axes (no extent).
    float len1 = sqrt(max(2.0f * lambda1 * boundPower, 0.0f));
    float len2 = sqrt(max(2.0f * lambda2 * boundPower, 0.0f));
    axis1 = dir1 * len1;
    axis2 = dir2 * len2;
}

RWStructuredBuffer<SplatTileData> _SplatTileData;
RWStructuredBuffer<uint> _SplatsDistances;
RWStructuredBuffer<uint> _SplatsKeys;
uint _StartTile;
uint _NumTiles;
uint _TileCountX, _TileCountY;
uint2 _TileSize;

[numthreads(GROUP_SIZE, 1, 1)]
void CSCalcViewDataAllTiled(uint3 dispatchId : SV_DispatchThreadID)
{
    uint idx = dispatchId.x;
    if (idx >= _SplatCount)
        return;

    // Load splat data 
    SplatData splat = LoadSplatData(idx);
    SplatTileData tile = (SplatTileData) 0;

    // world→view→clip
    float3 centerWorld = mul(_MatrixObjectToWorld, float4(splat.pos, 1)).xyz;
    float3 camSpace = mul(_MatrixMV, float4(splat.pos, 1)).xyz;
    float4 clipPos = mul(UNITY_MATRIX_VP, float4(centerWorld, 1));
    
    if (clipPos.w <= 0.0f)
    {
        // behind camera, bail
        _SplatTileData[idx] = tile;
        return;
    }

    // Alpha threshold culling (if enabled) 
    float opacityScaled = splat.opacity * _SplatOpacityScale;
    if (_UseCulling == 1 && opacityScaled <= _AlfaMin)
    {
        _SplatTileData[idx] = tile;
        return;
    }

    // Compute 3D→2D covariance and conic & power term 
    float3x3 rotScale = CalcMatrixFromRotationScale(splat.rot, splat.scale);

    float3 cov3d0, cov3d1;
    CalcCovariance3D(rotScale, cov3d0, cov3d1);

    float scaleFactor = _SplatScale * _SplatScale;
    cov3d0 *= scaleFactor;
    cov3d1 *= scaleFactor;

    float3 cov2d = CalcCovariance2DTiled( splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams );

    float3 conic = CalcConic(cov2d);
    float log2Opacity = log2(opacityScaled);
    float powerTerm = max(LN2 * 8.0f + LN2 * log2Opacity, 0.0f);

    // Size (r_p) culling (if enabled) 
    float2 axis1, axis2;
    DecomposeCovarianceScaled(cov2d, powerTerm, axis1, axis2);
    float r_p = max(length(axis1), length(axis2)) / abs(camSpace.z);
    if (_UseCulling == 1 && r_p <= _RMin)
    {
        _SplatTileData[idx] = tile;
        return;
    }

    // Compute pixel‐center 
    float2 centerNDC = clipPos.xy / clipPos.w;
    float2 center = float2(ndc2Pix(centerNDC.x, _VecScreenParams.x), ndc2Pix(centerNDC.y, _VecScreenParams.y));
    
    // Compute bounding‐tile rectangle in tile‐space 
    float rWf = 1.414214f * sqrt(cov2d.x * powerTerm) + 1.0f;
    float rHf = 1.414214f * sqrt(cov2d.z * powerTerm) + 1.0f;

    int2 rectMin = int2(
        clamp(int(floor((center.x - rWf) / _TileSize.x)), 0, int(_TileCountX)),
        clamp(int(floor((center.y - rHf) / _TileSize.y)), 0, int(_TileCountY))
    );
    int2 rectMax = int2(
        clamp(int(floor((center.x + rWf) / _TileSize.x)) + 1, 0, int(_TileCountX)),
        clamp(int(floor((center.y + rHf) / _TileSize.y)) + 1, 0, int(_TileCountY))
    );

    int tileSpanX = rectMax.x - rectMin.x;
    int tileSpanY = rectMax.y - rectMin.y;
    int totalTiles = tileSpanX * tileSpanY;

    // Single‐tile fast path 
    if (totalTiles == 1)
    {
        uint tx = rectMin.x;
        uint ty = rectMin.y;
        uint tileIndex = ty * _TileCountX + tx;

        int2 pixMin = int2(tx * _TileSize.x, ty * _TileSize.y);
        int2 pixMax = int2(
            min(pixMin.x + _TileSize.x - 1, int(_VecScreenParams.x) - 1),
            min(pixMin.y + _TileSize.y - 1, int(_VecScreenParams.y) - 1)
        );

        if (BlockContainsCenter(pixMin, pixMax, center) || BlockIntersectEllipse(pixMin, pixMax, center, conic, powerTerm))
        {
            uint writeIdx;
            
            InterlockedAdd(_SplatCounter[0], 1, writeIdx);
            InterlockedAdd(_SplatTileCounter[tileIndex], 1);
            
            _SplatsKeys[writeIdx] = idx;
            _SplatsDistances[writeIdx] = (tileIndex & 0xFFF) << 22 | (FloatToSortableUint(abs(camSpace.z)) >> 10);
        }
    }
    else
    {
        // Multi‐tile loop
        for (int ty = rectMin.y; ty < rectMax.y; ++ty)
        {
            for (int tx = rectMin.x; tx < rectMax.x; ++tx)
            {
                uint tileIndex = ty * _TileCountX + tx;

                int2 pixMin = int2(tx * _TileSize.x, ty * _TileSize.y);
                int2 pixMax = int2(
                    min(pixMin.x + _TileSize.x - 1, int(_VecScreenParams.x) - 1),
                    min(pixMin.y + _TileSize.y - 1, int(_VecScreenParams.y) - 1)
                );

                bool hit = BlockContainsCenter(pixMin, pixMax, center) || BlockIntersectEllipse(pixMin, pixMax, center, conic, powerTerm);

                if (hit)
                {
                    uint writeIdx;
                
                    InterlockedAdd(_SplatCounter[0], 1, writeIdx);
                    InterlockedAdd(_SplatTileCounter[tileIndex], 1);
                
                    _SplatsKeys[writeIdx] = idx;
                    _SplatsDistances[writeIdx] = (tileIndex & 0xFFF) << 22 | (FloatToSortableUint(abs(camSpace.z)) >> 10);
                }
            }
        }
    }
    
    if (totalTiles > 0)
    {
        // store the position in pixel coordinates (the remaining calculations are all in pixel coordinates)
        tile.pos.xy = center;

        // --- your existing ShadeSH + color pack code ---
        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorld;
        float3 objViewDir = normalize(mul((float3x3) _MatrixWorldToObject, worldViewDir));
        half4 col = half4(ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0), min(splat.opacity * _SplatOpacityScale, 65000));
        tile.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
        tile.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);

        // --- now only write the conic + power if this splat actually spans tiles: ---
        tile.conic.x = (-0.5f * LOG2E) * conic.x;
        tile.conic.y = -LOG2E * conic.y;
        tile.conic.z = (-0.5f * LOG2E) * conic.z;
        tile.conic.w = log2Opacity;
    }
    
    _SplatTileData[idx] = tile;
}


[numthreads(GROUP_SIZE, 1, 1)]
void CSCalcViewDataTiled(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData) 0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos, 1)).xyz;
    float3 camSpace = mul(_MatrixMV, float4(splat.pos, 1)).xyz;
    
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    // cutouts
    if (IsSplatCut(splat.pos))
    {
        centerClipPos.w = 0;
    }
    
    if (_UseCulling == 1)
    {
        // alfa threshold culling
        if (splat.opacity * opacityScale <= _AlfaMin)
        {
            centerClipPos.w = 0;
        }
    }
    
    view.pos = centerClipPos;
    bool culled = centerClipPos.w <= 0;
    if (!culled)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;
        splat.opacity *= opacityScale;
        
        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        // 2D covariance
        float3 cov2d = CalcCovariance2DTiled(splat.pos, cov3d0, cov3d1, _MatrixMV, UNITY_MATRIX_P, _VecScreenParams);
        
        float3 conic = CalcConic(cov2d); // Σ⁻¹.xx
        view.rawConic = conic;
        float log2Opacity = log2(splat.opacity);
        
        view.pow = max(LN2 * 8.0f + LN2 * log2Opacity, 0.0f);

        DecomposeCovarianceScaled(cov2d, view.pow, view.axis1, view.axis2);
        
        float depth = mul(_MatrixMV, float4(splat.pos, 1)).z;
        float r_p = max(length(view.axis1), length(view.axis2)) / abs(depth);
        
        if (_UseCulling == 1 && r_p <= _RMin)
        {
            centerClipPos.w = 0;
        }
        else
        {
            // calculate the pixel coordinates of the splat
            float2 centerNDC = view.pos.xy / view.pos.w;
            float2 screenCenter = float2(ndc2Pix(centerNDC.x, _VecScreenParams.x), ndc2Pix(centerNDC.y, _VecScreenParams.y));
            
            // store the position in pixel coordinates (the remaining calculations are all in pixel coordinates)
            view.pos.xy = screenCenter;
            // store the depth absolute value (the ones behind the camera are marked with w <= 0)
            view.pos.z = abs(camSpace.z);
            
            //calculate light information to calculate the color
            float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
            float3 objViewDir = mul((float3x3) _MatrixWorldToObject, worldViewDir);
            objViewDir = normalize(objViewDir);

            // calculate the color
            half4 col;
            col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
            col.a = min(splat.opacity, 65000);
            
            //Store the color
            view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
            view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
            
            // Store the conic for the color calculation
            view.conic.x = (-0.5f * LOG2E) * conic.x;
            view.conic.y = -LOG2E * conic.y;
            view.conic.z = (-0.5f * LOG2E) * conic.z;
            view.conic.w = log2Opacity;
        }
    }
    
    _SplatViewData[idx] = view;

}

StructuredBuffer<SplatViewData> _SplatViewDataReadOnly; //done

[numthreads(GROUP_SIZE, 1, 1)]
void CSCollectTileSplats(
    uint3 dispatchId : SV_DispatchThreadID,
    uint3 groupId : SV_GroupID
)
{
    uint idx = dispatchId.x;
    if (idx >= _SplatCount) 
        return;

    // which tile in our range?
    uint localTile = groupId.y;
    if (localTile >= _NumTiles)
        return;
    
    uint tileIndex = _StartTile + localTile;

    // load view data:
    SplatViewData view = _SplatViewDataReadOnly[idx];

    // Cull if invisible or behind near plane:
    if (view.pos.w <= 0.0f)
        return;

    float2 screenCenter = view.pos.xy;

    // derive tile X/Y from tileIndex:
    uint tileX = tileIndex % _TileCountX;
    uint tileY = tileIndex / _TileCountX;

    int screenW = (int) _VecScreenParams.x;
    int screenH = (int) _VecScreenParams.y;

    int tileW = _TileSize.x; 
    int tileH = _TileSize.y;

    int baseX = int(tileX) * tileW;
    int baseY = int(tileY) * tileH;

    int2 pixMin = int2(baseX, baseY);
    int2 pixMax = int2(
        min(baseX + tileW - 1, screenW - 1),
        min(baseY + tileH - 1, screenH - 1)
    );

    // AABB test:
    float2 a1 = view.axis1, a2 = view.axis2;
    float2 cornerMin = min(min(a1, a2), -max(a1, a2));
    float2 cornerMax = max(max(a1, a2), -min(a1, a2));
    float2 bbMin = screenCenter + cornerMin;
    float2 bbMax = screenCenter + cornerMax;

    // intersection:
    bool intersects = false;
    if (BlockContainsCenter(pixMin, pixMax, screenCenter) ||
        BlockIntersectEllipse(pixMin, pixMax, screenCenter, view.rawConic, view.pow))
    {
        intersects = true;
    }

    if (intersects)
    {
        uint writeIdx;
        InterlockedAdd(_SplatCounter[0], 1, writeIdx);
        InterlockedAdd(_SplatTileCounter[tileIndex], 1);
        _SplatsKeys[writeIdx] = idx;
        _SplatsDistances[writeIdx] = (tileIndex & 0xFF) << 24 | FloatToSortableUint(view.pos.z) >> 8;
    }

}

RWTexture2D<float4> _GaussianSplatRT; // Output buffer (e.g., HDR render target)

[numthreads(TILE_GROUP_SIZE, TILE_GROUP_SIZE, 1)]
void CSRenderTileSplats(
    uint3 tid : SV_GroupThreadID,
    uint3 groupId : SV_GroupID)
{
    uint localTile = groupId.z;
    if (localTile >= _NumTiles)
        return;

    uint tileIndex = _StartTile + localTile;
    uint tileX = tileIndex % _TileCountX;
    uint tileY = tileIndex / _TileCountX;
    
    // compute screen/tile dims
    int screenW = (int) _VecScreenParams.x;
    int screenH = (int) _VecScreenParams.y;
    int tileW = _TileSize.x;
    int tileH = _TileSize.y;
    
    int cols = (int) _TileCountX;
    //int tileW = (screenW + cols - 1) / cols;
    int x0 = tileX * tileW;
    int x1 = min(x0 + tileW, screenW);

    int rows = (int) _TileCountY;
    //int tileH = (screenH + rows - 1) / rows;
    int y0 = tileY * tileH;
    int y1 = min(y0 + tileH, screenH);

    // global pixel coordinate
    uint px = uint(x0) + groupId.x * TILE_GROUP_SIZE + tid.x;
    uint py = uint(y0) + groupId.y * TILE_GROUP_SIZE + tid.y;

    // clip out both the padding and any threads outside the tile’s true rectangle
    if (px < uint(x0) || px >= uint(x1) ||
        py < uint(y0) || py >= uint(y1))
        return;

    // now do your normal front-to-back composite for this pixel:
    uint2 pixelCoord = uint2(px, py);
    float2 pixelCenter = float2(px, py);

    uint counts = _SplatTileCounter[tileIndex];
    uint baseOffset = 0;
    for (uint t = 0; t < localTile; ++t)
        baseOffset += _SplatTileCounter[_StartTile + t];

    float3 C = 0;
    float T = 1.0;
    for (uint i = 0; i < counts; ++i)
    {
        uint splatIdx = _SplatsKeys[baseOffset + i];
        SplatViewData splat = _SplatViewDataReadOnly[splatIdx];

        // unpack SH-lit color
        float3 rgb = float3(
            f16tof32(splat.color.x >> 16),
            f16tof32(splat.color.x & 0xFFFF),
            f16tof32(splat.color.y >> 16)
        );

        float2 d = splat.pos.xy - pixelCenter;
        float power =
              splat.conic.w
            + splat.conic.x * d.x * d.x
            + splat.conic.y * d.x * d.y
            + splat.conic.z * d.y * d.y;

        float alpha = exp2(power);
        if (alpha < 1e-3) // alfa clipping
            continue;

        C += rgb * (alpha * T);
        T -= alpha * T;
        
        if (T < 1e-3) // early out for when the pixel is at "full" transparency
            break;
    }

    // flip Y and write out
    uint flippedY = uint(screenH) - 1 - pixelCoord.y;
    _GaussianSplatRT[uint2(pixelCoord.x, flippedY)] = float4(C + T * 0 /* bg */, 1);
}

#define PIXELS_PER_THREAD_X 15
#define PIXELS_PER_THREAD_Y 17

#define THREADS_X 8
#define THREADS_Y 4
//#define PIXELS_PER_THREAD (PIXELS_PER_THREAD_X * PIXELS_PER_THREAD_Y)  // 32 = 1 warp

#define COMBINED_BATCH_SIZE 64

groupshared float2 g_xy[COMBINED_BATCH_SIZE];
groupshared float3 g_rgb[COMBINED_BATCH_SIZE];
groupshared float4 g_con_o[COMBINED_BATCH_SIZE];

StructuredBuffer<SplatTileData> _SplatTileDataReadOnly;

[numthreads(8, 4, 1)]
void CSRenderAllTileSplatsCombined(uint3 tid : SV_GroupThreadID, uint3 gid : SV_GroupID)
{
    uint tileIdx = gid.z; 
    
    uint tileX = tileIdx % _TileCountX;
    uint tileY = tileIdx / _TileCountX;
    
    // Corrected base pixel calculation
    uint2 basePx = uint2(tileX, tileY) * _TileSize.xy;
    
    // Local pixel offsets [REMOVED gid.x/gid.y multiplication]
    uint2 localPx[PIXELS_PER_THREAD_Y][PIXELS_PER_THREAD_X];
    float2 pixelCenters[PIXELS_PER_THREAD_Y][PIXELS_PER_THREAD_X];
    
    for (uint py = 0; py < PIXELS_PER_THREAD_Y; py++)   
    {
        for (uint px = 0; px < PIXELS_PER_THREAD_X; px++)
        {
            uint2 local = basePx + uint2(
              tid.x * PIXELS_PER_THREAD_X + px,
              tid.y * PIXELS_PER_THREAD_Y + py
            );
            localPx[py][px] = local;
            pixelCenters[py][px] = float2(local) + 0.5;
        }
    }

    // Initialize accumulators
    float3 C[PIXELS_PER_THREAD_Y][PIXELS_PER_THREAD_X];
    float T[PIXELS_PER_THREAD_Y][PIXELS_PER_THREAD_X];
    
    for (uint py = 0; py < PIXELS_PER_THREAD_Y; py++)
    {
        for (uint px = 0; px < PIXELS_PER_THREAD_X; px++)
        {
            C[py][px] = float3(0, 0, 0);
            T[py][px] = 1.0f;
        }
    }

    // Get splat range
    uint baseOffset = (tileIdx == 0) ? 0u : _SplatTileCounter[tileIdx - 1];
    uint finalOffset = _SplatTileCounter[tileIdx];
    uint splatCount = finalOffset - baseOffset;
    
    uint laneIdx = WaveGetLaneIndex();

    for (uint currentBatch = baseOffset; currentBatch < finalOffset; currentBatch += COMBINED_BATCH_SIZE)
    {
        // Early termination check
        bool terminate = true;
        for (uint py = 0; py < PIXELS_PER_THREAD_Y; py++)
        {
            for (uint px = 0; px < PIXELS_PER_THREAD_X; px++)
            {
                terminate = (T[py][px] < 1e-3f) && terminate;
            }
        }
        
       if (WaveActiveAllTrue(terminate))
            break;
        
        // Load 2 Gaussians
        if (laneIdx < COMBINED_BATCH_SIZE)
        {
            uint splatTileIdx = currentBatch + laneIdx; // Removed range.x (always 0)
            if (splatTileIdx < finalOffset)
            {
                uint splatIdx = _SplatsKeys[splatTileIdx];
                SplatTileData g = _SplatTileDataReadOnly[splatIdx];
                
                // Correct color conversion
                float3 rgb = float3(f16tof32(g.color.x >> 16),f16tof32(g.color.x & 0xFFFF), f16tof32(g.color.y >> 16));
                
                g_xy[laneIdx] = g.pos.xy;
                g_rgb[laneIdx] = rgb;
                g_con_o[laneIdx] = g.conic;

            }
        }
        
        GroupMemoryBarrierWithGroupSync();

        // Process Gaussians
        for (uint i = 0; i < COMBINED_BATCH_SIZE; i++)
        {
            if (currentBatch + i >= finalOffset)
                continue;
            
            float2 xy = g_xy[i];
            float3 rgb = g_rgb[i];
            float4 con_o = g_con_o[i];

            for (uint py = 0; py < PIXELS_PER_THREAD_Y; py++)
            {
                for (uint px = 0; px < PIXELS_PER_THREAD_X; px++)
                {
                    if (T[py][px] > 1e-3f)
                    {
                        float2 d = pixelCenters[py][px] - xy;
                        
                        float power = con_o.w +
                                    con_o.x * d.x * d.x +
                                    con_o.z * d.y * d.y +
                                    con_o.y * d.x * d.y;
                        
                        float alpha = exp2(power);
                        
                        C[py][px] += rgb * (alpha * T[py][px]);
                        T[py][px] -= (alpha * T[py][px]);
                    }
                }
            }
        }
    }
    
    // Output
    for (uint py = 0; py < PIXELS_PER_THREAD_Y; py++)
    {
        for (uint px = 0; px < PIXELS_PER_THREAD_X; px++)
        {
            uint2 pxPos = localPx[py][px];
            if (pxPos.x < _VecScreenParams.x && pxPos.y < _VecScreenParams.y)
            {
                uint2 writePos = uint2(pxPos.x, uint(_VecScreenParams.y) - 1 - pxPos.y);
                _GaussianSplatRT[writePos] = float4(C[py][px], 1.0f);
            }
        }
    }
    
    
}

#define GROUP_SHARED_BATCHED 256

groupshared SplatTileData g_splatsShared[GROUP_SHARED_BATCHED];

[numthreads(TILE_GROUP_SIZE_X, TILE_GROUP_SIZE_Y, 1)]
void CSRenderAllTileSplatsGroupShared(
    uint3 tid : SV_GroupThreadID,
    uint3 groupId : SV_GroupID)
{
    uint tileIndex = groupId.z;
    if (tileIndex >= _NumTiles) 
        return;

    uint tileX = tileIndex % _TileCountX;
    uint tileY = tileIndex / _TileCountX;

    // compute pixel within full screen
    uint px = tileX * _TileSize.x + groupId.x * TILE_GROUP_SIZE_X + tid.x;
    uint py = tileY * _TileSize.y + groupId.y * TILE_GROUP_SIZE_Y + tid.y;

    // exact same “border‐check” as in CSRenderTileSplats:
    int x0 = tileX * _TileSize.x;
    int y0 = tileY * _TileSize.y;
    int x1 = min(x0 + _TileSize.x, _VecScreenParams.x);
    int y1 = min(y0 + _TileSize.y, _VecScreenParams.y);
    bool pixelOutsideTile = (px < x0 || px >= x1 || py < y0 || py >= y1);
    
    // Compute splat count and base offset
    uint baseOffset = (tileIndex == 0) ? 0u : _SplatTileCounter[tileIndex - 1];
    uint counts = _SplatTileCounter[tileIndex] - baseOffset;

    // Flattened thread index for cooperative load
    uint flatIdx = tid.y * TILE_GROUP_SIZE_X + tid.x;
    uint totalThreads = TILE_GROUP_SIZE_X * TILE_GROUP_SIZE_Y;

    // Accumulators
    float3 C = float3(0, 0, 0);
    float T = 1.0f;

    uint remaining = counts;
    uint batchBase = baseOffset;
    // Chunked loading and shading in batches of up to 1024 splats
    while (remaining > 0)
    {
        uint batchSize = min(remaining, GROUP_SHARED_BATCHED);

        // Load this batch into shared memory
        for (uint i = flatIdx; i < batchSize; i += totalThreads)
        {
            uint splatIdx = _SplatsKeys[batchBase + i];
            g_splatsShared[i] = _SplatTileDataReadOnly[splatIdx];
        }
        GroupMemoryBarrierWithGroupSync();

        // Shade each splat in this batch
        float2 pixelCenter = float2(px, py);
        for (uint i = 0; i < batchSize; ++i)
        {
            
            SplatTileData splat = g_splatsShared[i];
            // Unpack color
            float3 rgb = float3(
                 f16tof32(splat.color.x >> 16),
                 f16tof32(splat.color.x & 0xFFFF),
                 f16tof32(splat.color.y >> 16)
            );
            
            // Compute Gaussian power
            float2 d = splat.pos.xy - pixelCenter;
            float power = splat.conic.w
                        + splat.conic.x * d.x * d.x
                        + splat.conic.y * d.x * d.y
                        + splat.conic.z * d.y * d.y;
            float alpha = exp2(power);

            C += rgb * (alpha * T);
            T -= alpha * T;
            
            
        }
        
        // Advance to next batch
        remaining -= batchSize;
        batchBase += batchSize;

        // Barrier before reusing shared memory
        GroupMemoryBarrierWithGroupSync();
        
        bool terminate = T < 1e-3;
        if (WaveActiveAllTrue(terminate))
            break;
    }
    
    if (pixelOutsideTile)
        return;
    
    // Write final color
    uint flippedY = uint(_VecScreenParams.y) - 1 - py;
    _GaussianSplatRT[uint2(px, flippedY)] = float4(C, 1);

}


[numthreads(TILE_GROUP_SIZE_X, TILE_GROUP_SIZE_Y, 1)]
void CSRenderAllTileSplatsWave(
    uint3 tid : SV_GroupThreadID,
    uint3 groupId : SV_GroupID)
{
    uint tileIndex = groupId.z;
    if (tileIndex >= _NumTiles) 
        return;

    uint tileX = tileIndex % _TileCountX;
    uint tileY = tileIndex / _TileCountX;

    // compute pixel within full screen
    uint px = tileX * _TileSize.x + groupId.x * TILE_GROUP_SIZE + tid.x;
    uint py = tileY * _TileSize.y + groupId.y * TILE_GROUP_SIZE + tid.y;

    // exact same “border‐check” as in CSRenderTileSplats:
    int x0 = tileX * _TileSize.x;
    int y0 = tileY * _TileSize.y;
    int x1 = min(x0 + _TileSize.x, _VecScreenParams.x);
    int y1 = min(y0 + _TileSize.y, _VecScreenParams.y);
    bool pixelOutsideTile = (px < x0 || px >= x1 || py < y0 || py >= y1);

    // Precompute pixel center
    float2 pixelCenter = float2(px, py);

    // Compute prefix‑sum of splat counts to find baseOffset
    uint baseOffset = (tileIndex == 0) ? 0u : _SplatTileCounter[tileIndex - 1];
    uint counts = _SplatTileCounter[tileIndex] - baseOffset;

    // Accumulators
    float3 C = float3(0, 0, 0);
    float T = 1.0f;

    // Wave intrinsics helpers
    uint lane = WaveGetLaneIndex();
    bool isFirst = WaveIsFirstLane();

    // Main splat loop
    for (uint i = 0; i < counts; ++i)
    {
        // Fetch the key for this splat
        uint splatKey = _SplatsKeys[baseOffset + i];

        // Only lane 0 in each wave reads from global memory
        SplatTileData leaderData;
        if (isFirst)
        {
            leaderData = _SplatTileDataReadOnly[splatKey];
        }

        // Broadcast all fields from lane 0 to the wave
        float2 pos;
        pos = WaveReadLaneFirst(leaderData.pos);

        float4 conic;
        conic = WaveReadLaneFirst(leaderData.conic);

        uint2 colorBits;
        colorBits = WaveReadLaneFirst(leaderData.color);

        // Unpack FP16 color
        float3 rgb;
        rgb.x = f16tof32(colorBits.x >> 16);
        rgb.y = f16tof32(colorBits.x & 0xFFFF);
        rgb.z = f16tof32(colorBits.y >> 16);

        // Compute Gaussian weight
        float2 d = pos - pixelCenter;
        float power = conic.w
                     + conic.x * d.x * d.x
                     + conic.y * d.x * d.y
                     + conic.z * d.y * d.y;
        float alpha = exp2(power);

        // Front‑to‑back composite
        C += rgb * (alpha * T);
        T -= alpha * T;

        // Early‑out if nearly opaque
        //if (T < 1e-3f && !isFirst)
            //break;
    }

    if (pixelOutsideTile)
        return;
    
    // Flip Y and write final color (no background here)
    uint flippedY = uint(_VecScreenParams.y) - 1 - py;
    _GaussianSplatRT[uint2(px, flippedY)] = float4(C, 1.0f);
}

[numthreads(TILE_GROUP_SIZE_X, TILE_GROUP_SIZE_Y, 1)]
void CSRenderAllTileSplatsBase(
    uint3 tid : SV_GroupThreadID,
    uint3 groupId : SV_GroupID)
{
    uint localTile = groupId.z;
    if (localTile >= _NumTiles)
        return;

    uint tileIndex = _StartTile + localTile;
    uint tileX = tileIndex % _TileCountX;
    uint tileY = tileIndex / _TileCountX;
    
    // compute screen/tile dims
    int screenW = (int) _VecScreenParams.x;
    int screenH = (int) _VecScreenParams.y;
    int tileW = _TileSize.x;
    int tileH = _TileSize.y;
    
    int cols = (int) _TileCountX;
    //int tileW = (screenW + cols - 1) / cols;
    int x0 = tileX * tileW;
    int x1 = min(x0 + tileW, screenW);

    int rows = (int) _TileCountY;
    //int tileH = (screenH + rows - 1) / rows;
    int y0 = tileY * tileH;
    int y1 = min(y0 + tileH, screenH);

    // global pixel coordinate
    uint px = uint(x0) + groupId.x * TILE_GROUP_SIZE + tid.x;
    uint py = uint(y0) + groupId.y * TILE_GROUP_SIZE + tid.y;

    // clip out both the padding and any threads outside the tile’s true rectangle
    if (px < uint(x0) || px >= uint(x1) ||
        py < uint(y0) || py >= uint(y1))
        return;

    // now do your normal front-to-back composite for this pixel:
    uint2 pixelCoord = uint2(px, py);
    float2 pixelCenter = float2(px, py);

    uint baseOffset = (tileIndex == 0) ? 0u : _SplatTileCounter[tileIndex - 1];
    uint counts = _SplatTileCounter[tileIndex] - baseOffset;
    
    float3 C = 0;
    float T = 1.0;
    for (uint i = 0; i < counts; ++i)
    {
        uint splatIdx = _SplatsKeys[baseOffset + i];
        SplatTileData splat = _SplatTileDataReadOnly[splatIdx];

        // unpack SH-lit color
        float3 rgb = float3(
            f16tof32(splat.color.x >> 16),
            f16tof32(splat.color.x & 0xFFFF),
            f16tof32(splat.color.y >> 16)
        );

        float2 d = splat.pos.xy - pixelCenter;
        float power =
              splat.conic.w
            + splat.conic.x * d.x * d.x
            + splat.conic.y * d.x * d.y
            + splat.conic.z * d.y * d.y;

        float alpha = exp2(power);
        if (alpha < 1e-3) // alfa clipping
            continue;

        C += rgb * (alpha * T);
        T -= alpha * T;
        
        bool terminate = T < 1e-3;
        if (WaveActiveAllTrue(terminate))
            break;
    }

    // flip Y and write out
    uint flippedY = uint(screenH) - 1 - pixelCoord.y;
    _GaussianSplatRT[uint2(pixelCoord.x, flippedY)] = float4(C + T * 0 /* bg */, 1);
}

RWByteAddressBuffer _DstBuffer;
ByteAddressBuffer _SrcBuffer;
uint _BufferSize;

uint2 GetSplatIndicesFromWord(uint idx)
{
    uint idxStart = idx * 32;
    uint idxEnd = min(idxStart + 32, _SplatCount);
    return uint2(idxStart, idxEnd);
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdateEditData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;

    uint valSel = _SplatSelectedBits.Load(idx * 4);
    uint valDel = _SplatDeletedBits.Load(idx * 4);
    valSel &= ~valDel; // don't count deleted splats as selected
    uint2 splatIndices = GetSplatIndicesFromWord(idx);

    // update selection bounds
    float3 bmin = 1.0e38;
    float3 bmax = -1.0e38;
    uint mask = 1;
    uint valCut = 0;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        // don't count cut splats as selected
        if (IsSplatCut(spos))
        {
            valSel &= ~mask;
            valCut |= mask;
        }
        if (valSel & mask)
        {
            bmin = min(bmin, spos);
            bmax = max(bmax, spos);
        }
    }
    valCut &= ~valDel; // don't count deleted splats as cut

    if (valSel != 0)
    {
        _DstBuffer.InterlockedMin(12, FloatToSortableUint(bmin.x));
        _DstBuffer.InterlockedMin(16, FloatToSortableUint(bmin.y));
        _DstBuffer.InterlockedMin(20, FloatToSortableUint(bmin.z));
        _DstBuffer.InterlockedMax(24, FloatToSortableUint(bmax.x));
        _DstBuffer.InterlockedMax(28, FloatToSortableUint(bmax.y));
        _DstBuffer.InterlockedMax(32, FloatToSortableUint(bmax.z));
    }
    uint sumSel = countbits(valSel);
    uint sumDel = countbits(valDel);
    uint sumCut = countbits(valCut);
    _DstBuffer.InterlockedAdd(0, sumSel);
    _DstBuffer.InterlockedAdd(4, sumDel);
    _DstBuffer.InterlockedAdd(8, sumCut);
}

[numthreads(1,1,1)]
void CSInitEditData (uint3 id : SV_DispatchThreadID)
{
    _DstBuffer.Store3(0, uint3(0,0,0)); // selected, deleted, cut counts
    uint initMin = FloatToSortableUint(1.0e38);
    uint initMax = FloatToSortableUint(-1.0e38);
    _DstBuffer.Store3(12, uint3(initMin, initMin, initMin));
    _DstBuffer.Store3(24, uint3(initMax, initMax, initMax));
}

[numthreads(GROUP_SIZE,1,1)]
void CSClearBuffer (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    _DstBuffer.Store(idx * 4, 0);
}

[numthreads(GROUP_SIZE,1,1)]
void CSInvertSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = _DstBuffer.Load(idx * 4);
    v = ~v;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSelectAll (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = ~0;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}


[numthreads(GROUP_SIZE,1,1)]
void CSOrBuffers (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint a = _SrcBuffer.Load(idx * 4);
    uint b = _DstBuffer.Load(idx * 4);
    _DstBuffer.Store(idx * 4, a | b);
}

float4 _SelectionRect;

[numthreads(GROUP_SIZE,1,1)]
void CSSelectionUpdate (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(UNITY_MATRIX_VP, float4(centerWorldPos, 1));
    centerClipPos.y *= -1;
    bool behindCam = centerClipPos.w <= 0;
    if (behindCam)
        return;

    float2 pixelPos = (centerClipPos.xy / centerClipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    if (pixelPos.x < _SelectionRect.x || pixelPos.x > _SelectionRect.z ||
        pixelPos.y < _SelectionRect.y || pixelPos.y > _SelectionRect.w)
    {
        return;
    }
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx); // +
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx)); // -
}

float3 _SelectionDelta;

bool IsSplatSelected(uint idx)
{
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
    return (selVal & (1 << bitIdx)) != 0;
}

[numthreads(GROUP_SIZE,1,1)]
void CSTranslateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPos.Load3(idx * stride));
        pos += _SelectionDelta;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

float3 _SelectionCenter;
float4 _SelectionDeltaRot;
ByteAddressBuffer _SplatPosMouseDown;
ByteAddressBuffer _SplatOtherMouseDown;

[numthreads(GROUP_SIZE,1,1)]
void CSRotateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint posFmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && posFmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * posStride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos = QuatRotateVector(pos, _SelectionDeltaRot);
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * posStride, asuint(pos));
    }

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    if (_SplatChunkCount == 0 && scaleFmt == VECTOR_FMT_32F && shFormat == VECTOR_FMT_32F)
    {
        uint otherStride = 4 + 12;
        uint rotVal = _SplatOtherMouseDown.Load(idx * otherStride);
        float4 rot = DecodeRotation(DecodePacked_10_10_10_2(rotVal));

        //@TODO: correct rotation
        rot = QuatMul(rot, _SelectionDeltaRot);

        rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(rot));
        _SplatOther.Store(idx * otherStride, rotVal);
    }

    //@TODO: rotate SHs
}

//@TODO: maybe scale the splat scale itself too?
[numthreads(GROUP_SIZE,1,1)]
void CSScaleSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * stride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos *= _SelectionDelta;
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * stride, asuint(pos));
    }
}

struct ExportSplatData
{
    float3 pos;
    float3 nor;
    float3 dc0;
    float4 shR14; float4 shR58; float4 shR9C; float3 shRDF;
    float4 shG14; float4 shG58; float4 shG9C; float3 shGDF;
    float4 shB14; float4 shB58; float4 shB9C; float3 shBDF;
    float opacity;
    float3 scale;
    float4 rot;
};
RWStructuredBuffer<ExportSplatData> _ExportBuffer;

float3 ColorToSH0(float3 col)
{
    return (col - 0.5) / 0.2820948;
}
float InvSigmoid(float v)
{
    return log(v / max(1 - v, 1.0e-6));
}

// SH rotation
#include "SphericalHarmonics.hlsl"

void RotateSH(inout SplatSHData sh, float3x3 rot)
{
    float3 shin[16];
    float3 shout[16];
    shin[0] = sh.col;
    shin[1] = sh.sh1;
    shin[2] = sh.sh2;
    shin[3] = sh.sh3;
    shin[4] = sh.sh4;
    shin[5] = sh.sh5;
    shin[6] = sh.sh6;
    shin[7] = sh.sh7;
    shin[8] = sh.sh8;
    shin[9] = sh.sh9;
    shin[10] = sh.sh10;
    shin[11] = sh.sh11;
    shin[12] = sh.sh12;
    shin[13] = sh.sh13;
    shin[14] = sh.sh14;
    shin[15] = sh.sh15;
    RotateSH(rot, 4, shin, shout);
    sh.col = shout[0];
    sh.sh1 = shout[1];
    sh.sh2 = shout[2];
    sh.sh3 = shout[3];
    sh.sh4 = shout[4];
    sh.sh5 = shout[5];
    sh.sh6 = shout[6];
    sh.sh7 = shout[7];
    sh.sh8 = shout[8];
    sh.sh9 = shout[9];
    sh.sh10 = shout[10];
    sh.sh11 = shout[11];
    sh.sh12 = shout[12];
    sh.sh13 = shout[13];
    sh.sh14 = shout[14];
    sh.sh15 = shout[15];
}

float3x3 CalcSHRotMatrix(float4x4 objToWorld)
{
    float3x3 m = (float3x3)objToWorld;
    float sx = length(float3(m[0][0], m[0][1], m[0][2]));
    float sy = length(float3(m[1][0], m[1][1], m[1][2]));
    float sz = length(float3(m[2][0], m[2][1], m[2][2]));

    float invSX = 1.0 / sx;
    float invSY = 1.0 / sy;
    float invSZ = 1.0 / sz;

    m[0][0] *= invSX;
    m[0][1] *= invSX;
    m[0][2] *= invSX;
    m[1][0] *= invSY;
    m[1][1] *= invSY;
    m[1][2] *= invSY;
    m[2][0] *= invSZ;
    m[2][1] *= invSZ;
    m[2][2] *= invSZ;
    return m;
}


float4 _ExportTransformRotation;
float3 _ExportTransformScale;
uint _ExportTransformFlags;

[numthreads(GROUP_SIZE,1,1)]
void CSExportData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    SplatData src = LoadSplatData(idx);

    bool isCut = IsSplatCut(src.pos);

    // transform splat by matrix, if needed
    if (_ExportTransformFlags != 0)
    {
        src.pos = mul(_MatrixObjectToWorld, float4(src.pos,1)).xyz;

        // note: this only handles axis flips from scale, not any arbitrary scaling
        if (_ExportTransformScale.x < 0)
            src.rot.yz = -src.rot.yz;
        if (_ExportTransformScale.y < 0)
            src.rot.xz = -src.rot.xz;
        if (_ExportTransformScale.z < 0)
            src.rot.xy = -src.rot.xy;
        src.rot = QuatMul(_ExportTransformRotation, src.rot);
        src.scale *= abs(_ExportTransformScale);

        float3x3 shRot = CalcSHRotMatrix(_MatrixObjectToWorld);
        RotateSH(src.sh, shRot);
    }

    ExportSplatData dst;
    dst.pos = src.pos;
    dst.nor = 0;
    dst.dc0 = ColorToSH0(src.sh.col);
    
    dst.shR14 = float4(src.sh.sh1.r, src.sh.sh2.r, src.sh.sh3.r, src.sh.sh4.r);
    dst.shR58 = float4(src.sh.sh5.r, src.sh.sh6.r, src.sh.sh7.r, src.sh.sh8.r);
    dst.shR9C = float4(src.sh.sh9.r, src.sh.sh10.r, src.sh.sh11.r, src.sh.sh12.r);
    dst.shRDF = float3(src.sh.sh13.r, src.sh.sh14.r, src.sh.sh15.r);
    
    dst.shG14 = float4(src.sh.sh1.g, src.sh.sh2.g, src.sh.sh3.g, src.sh.sh4.g);
    dst.shG58 = float4(src.sh.sh5.g, src.sh.sh6.g, src.sh.sh7.g, src.sh.sh8.g);
    dst.shG9C = float4(src.sh.sh9.g, src.sh.sh10.g, src.sh.sh11.g, src.sh.sh12.g);
    dst.shGDF = float3(src.sh.sh13.g, src.sh.sh14.g, src.sh.sh15.g);
    
    dst.shB14 = float4(src.sh.sh1.b, src.sh.sh2.b, src.sh.sh3.b, src.sh.sh4.b);
    dst.shB58 = float4(src.sh.sh5.b, src.sh.sh6.b, src.sh.sh7.b, src.sh.sh8.b);
    dst.shB9C = float4(src.sh.sh9.b, src.sh.sh10.b, src.sh.sh11.b, src.sh.sh12.b);
    dst.shBDF = float3(src.sh.sh13.b, src.sh.sh14.b, src.sh.sh15.b);
    
    dst.opacity = InvSigmoid(src.opacity);
    dst.scale = log(src.scale);
    dst.rot = src.rot.wxyz;

    if (isCut)
        dst.nor = 1; // mark as skipped for export
    
    _ExportBuffer[idx] = dst;
}

RWByteAddressBuffer _CopyDstPos;
RWByteAddressBuffer _CopyDstOther;
RWByteAddressBuffer _CopyDstSH;
RWByteAddressBuffer _CopyDstEditDeleted;
RWTexture2D<float4> _CopyDstColor;
uint _CopyDstSize, _CopySrcStartIndex, _CopyDstStartIndex, _CopyCount;

float4x4 _CopyTransformMatrix;
float4 _CopyTransformRotation;
float3 _CopyTransformScale;

[numthreads(GROUP_SIZE,1,1)]
void CSCopySplats (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _CopyCount)
        return;
    uint srcIdx = _CopySrcStartIndex + idx;
    uint dstIdx = _CopyDstStartIndex + idx;
    if (srcIdx >= _SplatCount || dstIdx >= _CopyDstSize)
        return;

    SplatData src = LoadSplatData(idx);

    // transform the splat
    src.pos = mul(_CopyTransformMatrix, float4(src.pos,1)).xyz;
    // note: this only handles axis flips from scale, not any arbitrary scaling
    if (_CopyTransformScale.x < 0)
        src.rot.yz = -src.rot.yz;
    if (_CopyTransformScale.y < 0)
        src.rot.xz = -src.rot.xz;
    if (_CopyTransformScale.z < 0)
        src.rot.xy = -src.rot.xy;
    src.rot = QuatMul(_CopyTransformRotation, src.rot);
    src.scale *= abs(_CopyTransformScale);

    float3x3 shRot = CalcSHRotMatrix(_CopyTransformMatrix);
    RotateSH(src.sh, shRot);

    // output data into destination:
    // pos
    uint posStride = 12;
    _CopyDstPos.Store3(dstIdx * posStride, asuint(src.pos));
    // rot + scale
    uint otherStride = 4 + 12;
    uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(src.rot));
    _CopyDstOther.Store4(dstIdx * otherStride, uint4(
        rotVal,
        asuint(src.scale.x),
        asuint(src.scale.y),
        asuint(src.scale.z)));
    // color
    uint3 pixelIndex = SplatIndexToPixelIndex(dstIdx);
    _CopyDstColor[pixelIndex.xy] = float4(src.sh.col, src.opacity);

    // SH
    uint shStride = 192; // 15*3 fp32, rounded up to multiple of 16
    uint shOffset = dstIdx * shStride;
    _CopyDstSH.Store3(shOffset + 12 * 0, asuint(src.sh.sh1));
    _CopyDstSH.Store3(shOffset + 12 * 1, asuint(src.sh.sh2));
    _CopyDstSH.Store3(shOffset + 12 * 2, asuint(src.sh.sh3));
    _CopyDstSH.Store3(shOffset + 12 * 3, asuint(src.sh.sh4));
    _CopyDstSH.Store3(shOffset + 12 * 4, asuint(src.sh.sh5));
    _CopyDstSH.Store3(shOffset + 12 * 5, asuint(src.sh.sh6));
    _CopyDstSH.Store3(shOffset + 12 * 6, asuint(src.sh.sh7));
    _CopyDstSH.Store3(shOffset + 12 * 7, asuint(src.sh.sh8));
    _CopyDstSH.Store3(shOffset + 12 * 8, asuint(src.sh.sh9));
    _CopyDstSH.Store3(shOffset + 12 * 9, asuint(src.sh.sh10));
    _CopyDstSH.Store3(shOffset + 12 * 10, asuint(src.sh.sh11));
    _CopyDstSH.Store3(shOffset + 12 * 11, asuint(src.sh.sh12));
    _CopyDstSH.Store3(shOffset + 12 * 12, asuint(src.sh.sh13));
    _CopyDstSH.Store3(shOffset + 12 * 13, asuint(src.sh.sh14));
    _CopyDstSH.Store3(shOffset + 12 * 14, asuint(src.sh.sh15));

    // deleted bits
    uint srcWordIdx = srcIdx / 32;
    uint srcBitIdx = srcIdx & 31;
    if (_SplatDeletedBits.Load(srcWordIdx * 4) & (1u << srcBitIdx))
    {
        uint dstWordIdx = dstIdx / 32;
        uint dstBitIdx = dstIdx & 31;
        _CopyDstEditDeleted.InterlockedOr(dstWordIdx * 4, 1u << dstBitIdx);
    }
}
